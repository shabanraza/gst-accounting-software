# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to 
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth (required for login/signup persistence)
BETTER_AUTH_SECRET=
# Local dev: http://localhost:3000  |  Production (Cloudflare secret): https://hisaabkro.in
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; email/password works without these).
# Authorised redirect URI in Google Cloud Console must be
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The "Continue with Google" buttons show by default. Uncomment to hide them —
# `bun run deploy` already sets this for the Cloudflare build. Without the two
# secrets above the buttons render but the flow fails with a toast.
# VITE_ENABLE_GOOGLE_AUTH=false

# Transactional email via Resend free tier (optional in dev; links log to console)
RESEND_API_KEY=
EMAIL_FROM=HisaabKro <onboarding@resend.dev>

# Set to true once auth DB tables are migrated and you want /app gated
VITE_REQUIRE_AUTH=false

# TanStack Router/Query devtools (off by default — FAB can block voucher Save)
# VITE_ENABLE_DEVTOOLS=true

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable —
# build-time var like VITE_ENABLE_GOOGLE_AUTH, so it must be set for `bun run build`/deploy.
VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification value (Settings > Ownership verification
# > HTML tag > copy just the `content="..."` value). Leave blank until verifying.
VITE_GOOGLE_SITE_VERIFICATION=

# Public forms (waitlist, feedback, contact). Submissions are stored in
# marketing_submissions; CONTACT_INBOX receives a Resend notification per entry.
CONTACT_INBOX=
# Cloudflare Turnstile spam check — leave both blank to skip in dev.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
